(ert-deftest teams4e-view-analysis-cancels-loader-and-ignores-stale-ticks ()
  (teams4e-view-test-session
    (with-current-buffer headers (teams4e-analyze-view))
    (let* ((progress (get-buffer teams4e-view-analysis--buffer-name))
           (token (buffer-local-value 'teams4e-view-analysis--token progress))
           (timer (buffer-local-value 'teams4e-view-analysis--timer progress)))
      (teams4e-view-analysis-cancel)
      (should-not (memq timer timer-list))
      (should-not global-mode-string)
      (with-current-buffer headers (teams4e-analyze-view))
      (let ((header (buffer-local-value 'header-line-format progress)))
        (teams4e-view-analysis--tick progress token)
        (should (equal header (buffer-local-value 'header-line-format progress))))
      (setq timer (buffer-local-value 'teams4e-view-analysis--timer progress))
      (kill-buffer progress)
      (should-not (memq timer timer-list))
      (should-not global-mode-string))))

(ert-deftest teams4e-view-analysis-notification-errors-do-not-break-completion ()
  (let ((teams4e-notifications t)
        (original-require (symbol-function 'require))
        notified)
    (cl-letf (((symbol-function 'require)
               (lambda (feature &rest args)
                 (if (eq feature 'notifications) t
                   (apply original-require feature args))))
              ((symbol-function 'notifications-notify)
               (lambda (&rest args)
                 (setq notified args)
                 (error "No desktop notification service"))))
      (teams4e-view-analysis--notify "Teams context ready: 2 histories; 0 unavailable"))
    (should (equal "Teams view analysis" (plist-get notified :title)))
    (should-not (string-match-p "chatId\\|token\\|example.test" (plist-get notified :body)))))

(ert-deftest teams4e-view-analysis-evil-G-works-in-normal-and-motion ()
  (skip-unless (featurep 'evil))
  (evil-mode 1)
  (dolist (mode '(teams4e-recent-mode teams4e-chat-mode))
    (dolist (state '(normal motion))
      (with-temp-buffer
        (funcall mode)
        (evil-change-state state)
        (should (eq #'teams4e-analyze-view (key-binding (kbd "G"))))
        (teams4e-install-headers-bindings)
        (teams4e-install-chat-reader-bindings)
        (teams4e-evil-refresh-bookmark-bindings)
        (should (eq #'teams4e-analyze-view (key-binding (kbd "G")))))))
  (dolist (state '(normal motion))
    (with-temp-buffer
      (teams4e-view-analysis-mode)
      (evil-change-state state)
      (should (eq #'quit-window (key-binding (kbd "q"))))
      (should (eq #'teams4e-view-analysis-status (key-binding (kbd "RET"))))
      (should (eq #'teams4e-view-analysis-retry (key-binding (kbd "r"))))
      (should (eq #'teams4e-view-analysis-cancel (key-binding (kbd "C-c C-k")))))))

(ert-deftest teams4e-view-analysis-reuses-exports-and-keeps-the-discussion ()
  (teams4e-view-test-session
    (with-current-buffer headers (teams4e-analyze-view))
    (teams4e-view-test-complete (car requests))
    (teams4e-view-test-complete (cadr requests))
    (let ((previous (plist-get teams4e-view-analysis--session :index)))
      (with-current-buffer headers (teams4e-analyze-view))
      (should (= 2 (length requests)))
      (should (= 1 (length launches)))
      (should (= 2 (length submitted)))
      (should (plist-get (car submitted) :no-focus))
      (should (eq shell (plist-get (car submitted) :shell-buffer)))
      (should-not (equal previous (plist-get teams4e-view-analysis--session :index)))
      (with-temp-buffer
        (insert-file-contents (plist-get teams4e-view-analysis--session :index))
        (should (search-forward previous nil t))
        (should (search-forward "REUSED snapshot" nil t))
        (should-not (string-match-p "fixture-account" (buffer-string)))))))

(ert-deftest teams4e-view-analysis-refreshes-changed-expired-and-forced-histories ()
  (teams4e-view-test-session
    (with-current-buffer headers (teams4e-analyze-view))
    (teams4e-view-test-complete (car requests))
    (teams4e-view-test-complete (cadr requests))
    ;; Read/triage state alone must not force a full-history read.
    (puthash "a" (cons 'read nil) teams4e--read-overrides)
    (push '(lastUpdatedDateTime . "2026-11-05T08:00:00Z") (car teams4e--chats))
    (with-current-buffer headers (teams4e-analyze-view))
    (should (= 3 (length requests)))
    (should (equal "a" (car (last (car (nth 2 requests))))))
    (teams4e-view-test-complete (nth 2 requests))
    (let ((entry (gethash "b" (plist-get teams4e-view-analysis--session :exports))))
      (setf (plist-get entry :time) (- (float-time) 301)))
    (with-current-buffer headers (teams4e-analyze-view))
    (should (= 4 (length requests)))
    (teams4e-view-test-complete (nth 3 requests))
    (teams4e-view-analysis-refresh t)
    (teams4e-view-test-complete (nth 4 requests))
    (teams4e-view-test-complete (nth 5 requests))
    (should (= 6 (length requests)))
    (should (= 1 (length launches)))
    (should (= 4 (length submitted)))))

(ert-deftest teams4e-view-analysis-retry-keeps-success-and-frozen-scope ()
  (teams4e-view-test-session
    (with-current-buffer headers (teams4e-analyze-view))
    (teams4e-view-test-complete (car requests))
    (funcall (nth 2 (cadr requests)) "401" "Token unavailable")
    (with-current-buffer headers (setq tabulated-list-entries '(("hidden" []))))
    (let ((teams4e-view-analysis-reuse-seconds 0))
      (teams4e-view-analysis-retry))
    (should (= 3 (length requests)))
    (should (equal "a" (car (last (car (nth 2 requests))))))
    (teams4e-view-test-complete (nth 2 requests))
    (should (= 1 (length launches)))
    (should (= 2 (length submitted)))
    (with-temp-buffer
      (insert-file-contents (plist-get teams4e-view-analysis--session :index))
      (should (search-forward "Coverage: 2 of 2 complete histories; 0 unavailable" nil t))
      (should-not (string-match-p "Hidden unrelated" (buffer-string))))))

(ert-deftest teams4e-view-analysis-cancelled-export-resumes-without-repeating-success ()
  (teams4e-view-test-session
    (with-current-buffer headers (teams4e-analyze-view))
    (teams4e-view-test-complete (car requests))
    (kill-buffer teams4e-view-analysis--buffer-name)
    (teams4e-view-analysis-retry)
