(ert-deftest teams4e-view-analysis-waits-for-agent-and-preserves-user-draft-and-focus ()
  (teams4e-view-test-session
    (with-current-buffer headers (teams4e-analyze-view))
    (teams4e-view-test-complete (car requests))
    (teams4e-view-test-complete (cadr requests))
    (let ((ready nil))
      (cl-letf (((symbol-function 'teams4e-companion--ready-p)
                 (lambda (&optional buffer) (should (eq shell buffer)) ready)))
        (with-current-buffer shell (insert "my unfinished prompt"))
        (with-current-buffer headers (teams4e-analyze-view))
        (let* ((progress (get-buffer teams4e-view-analysis--buffer-name))
               (token (buffer-local-value 'teams4e-view-analysis--token progress)))
          (should (= 1 (length submitted)))
          (should (eq 'waiting (plist-get (buffer-local-value 'teams4e-view-analysis--progress progress) :state)))
          (should (timerp (buffer-local-value 'teams4e-view-analysis--timer progress)))
          (teams4e-view-analysis--tick progress token)
          (should (= 1 (length submitted)))
          (should (equal "my unfinished prompt" (with-current-buffer shell (buffer-string))))
          (switch-to-buffer headers)
          (setq ready t)
          (let ((layout (current-window-configuration)))
            (teams4e-view-analysis--tick progress token)
            (should (compare-window-configurations layout (current-window-configuration))))
          (teams4e-view-analysis--tick progress token)
          (should (= 2 (length submitted)))
          (should-not (buffer-local-value 'teams4e-view-analysis--timer progress)))))))

