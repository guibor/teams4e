(ert-deftest teams4e-view-analysis-large-reuse-batches-yield-without-recursion ()
  (teams4e-view-test-session
    (setq teams4e--chats
          (cl-loop for n below 100 collect `((id . ,(format "chat-%d" n)))))
    (with-current-buffer headers
      (setq tabulated-list-entries
            (mapcar (lambda (chat) (list (teams4e--chat-id chat) [])) teams4e--chats)))
    (cl-letf (((symbol-function 'teams4e--run-json)
               (lambda (_args callback &optional _error)
                 (teams4e-view-test-complete (list nil callback))
                 (teams4e--make-request 1))))
      (with-current-buffer headers (teams4e-analyze-view))
      (should-not submitted) ; Large synchronous batches yield to Emacs.
      (let ((deadline (+ (float-time) 5)))
        (while (and (not submitted) (< (float-time) deadline))
          (accept-process-output nil 0.02)))
      (should (= 1 (length submitted))))
    (with-current-buffer headers (teams4e-analyze-view))
    (let ((deadline (+ (float-time) 5)))
      (while (and (< (length submitted) 2) (< (float-time) deadline))
        (accept-process-output nil 0.02)))
    (should (= 1 (length launches)))
    (should (= 2 (length submitted)))
    (should-not requests)))

