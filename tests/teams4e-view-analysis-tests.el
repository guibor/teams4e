(ert-deftest teams4e-view-analysis-loader-shows-elapsed-counts-without-polling ()
  (teams4e-view-test-session
    (with-current-buffer headers (teams4e-analyze-view))
    (let ((progress (get-buffer teams4e-view-analysis--buffer-name)))
      (with-current-buffer progress
        (should (timerp teams4e-view-analysis--timer))
        (should (member teams4e-view-analysis--mode-line-entry global-mode-string))
        (let* ((started (plist-get teams4e-view-analysis--progress :started))
               (later (+ started 301)))
          (cl-letf (((symbol-function 'float-time) (lambda (&rest _) later)))
            (teams4e-view-analysis--tick progress teams4e-view-analysis--token))
          (should (string-match-p "0/2.*5:01" header-line-format))
          (should (string-match-p "Beta" header-line-format))))
      (should (= 1 (length requests)))
      (teams4e-view-test-complete (car requests))
      (with-current-buffer progress
        (should (string-match-p "1/2" header-line-format))
        (should (string-match-p "Alpha" header-line-format)))
      (should (= 2 (length requests))))))

(ert-deftest teams4e-view-analysis-hidden-completion-does-not-steal-focus ()
  (teams4e-view-test-session
    (with-current-buffer headers (teams4e-analyze-view))
    (let ((progress (get-buffer teams4e-view-analysis--buffer-name)))
      (with-selected-window (get-buffer-window progress)
        (should (eq #'quit-window (key-binding (kbd "q"))))
        (call-interactively #'quit-window))
      (should (buffer-local-value 'teams4e-view-analysis--token progress))
      (switch-to-buffer headers)
      (let ((window (selected-window))
            (layout (current-window-configuration))
            (position (point)))
        (teams4e-view-test-complete (car requests))
        (teams4e-view-test-complete (cadr requests))
        (should (eq window (selected-window)))
        (should (eq headers (window-buffer window)))
        (should (= position (point)))
        (should (compare-window-configurations layout (current-window-configuration))))
      (should (plist-get (caar launches) :no-focus))
      (should (eq 'new (plist-get (caar launches) :session-strategy)))
      (should (plist-get (car submitted) :no-focus))
      (should (eq shell (plist-get (car submitted) :shell-buffer)))
      (with-current-buffer progress
        (should-not teams4e-view-analysis--timer)
        (should (eq 'ready (plist-get teams4e-view-analysis--progress :state))))
      (should (member teams4e-view-analysis--mode-line-entry global-mode-string))
      (should (string-match-p "Teams context ready" (teams4e-view-analysis--mode-line-text)))
      (teams4e-view-analysis-status)
      (should (eq shell (window-buffer (selected-window))))
      (should-not (member teams4e-view-analysis--mode-line-entry global-mode-string)))))

