(ert-deftest teams4e-view-analysis-progress-is-numeric-scoped-and-ignores-late-updates ()
  (teams4e-view-test-session
    (let (callbacks)
      (cl-letf (((symbol-function 'teams4e--run-json)
                 (lambda (args success &optional failure)
                   (push teams4e--request-progress-callback callbacks)
                   (setq requests (append requests (list (list args success failure))))
                   (teams4e--make-request (length requests)))))
        (with-current-buffer headers (teams4e-analyze-view))
        (funcall (car callbacks) '((stage . "download") (pages . 4) (messages . 200)))
        (with-current-buffer teams4e-view-analysis--buffer-name
          (should (string-match-p "4 pages, 200 messages" header-line-format)))
        (funcall (car callbacks) '((stage . "throttle") (retryAfterSeconds . 30)))
        (with-current-buffer teams4e-view-analysis--buffer-name
          (should (string-match-p "rate limit (30s backoff)" header-line-format)))
        (teams4e-view-test-complete (car requests))
        (funcall (cadr callbacks) '((stage . "download") (pages . 900)))
        (with-current-buffer teams4e-view-analysis--buffer-name
          (should-not (plist-get teams4e-view-analysis--progress :pages)))
        (funcall (car callbacks) '((stage . "secret-content") (messages . "token")))
        (with-current-buffer teams4e-view-analysis--buffer-name
          (should-not (string-match-p "secret-content\\|token" header-line-format)))))))

