;;; teams4e-reliability-tests.el --- Async reader regressions -*- lexical-binding: t; -*-

(require 'ert)
(require 'teams4e)

(ert-deftest teams4e-backend-fingerprint-detects-in-place-module-updates ()
  (let* ((directory (make-temp-file "teams4e-backend-version-" t))
         (program (expand-file-name "teams4e-graph" directory))
         (module (expand-file-name "teams4e_http.py" directory)))
    (unwind-protect
        (progn
          (with-temp-file program (insert "fixture launcher"))
          (with-temp-file module (insert "fixture version one"))
          (let ((before (teams4e--current-server-fingerprint program)))
            (should (equal before (teams4e--current-server-fingerprint program)))
            (with-temp-file module (insert "fixture version two, updated"))
            (should-not (equal before (teams4e--current-server-fingerprint program)))))
      (delete-directory directory t))))

(ert-deftest teams4e-backend-timings-accept-only-known-numeric-stages ()
  (let ((teams4e--performance-events nil))
    (teams4e--record-backend-timings
     '("teams" "chat" "message" "list" "--chatId" "private-id")
     '((httpMs . 123.0) (httpCalls . 2) (queueMs . 5) (authMs . "private-token")
       (cacheMs . -1) (unexpected . "private-message")))
    (should (= 2 (length teams4e--performance-events)))
    (should-not (string-match-p "private" (prin1-to-string teams4e--performance-events)))
    (should (= 2 (plist-get (car teams4e--performance-events) :items)))
    (should (= 123.0 (plist-get (car teams4e--performance-events) :duration-ms)))))

(ert-deftest teams4e-rich-reader-does-not-render-discarded-plain-text ()
  (with-temp-buffer
    (teams4e-chat-mode)
    (cl-letf (((symbol-function 'teams4e--agent-shell-markdown-available-p) (lambda () t))
              ((symbol-function 'teams4e--html-to-text)
               (lambda (&rest _) (ert-fail "Rich rendering performed redundant SHR conversion")))
              ((symbol-function 'teams4e--insert-rendered-markdown)
               (lambda (text) (insert text "\n"))))
      (let ((teams4e-display-images nil)
            (inhibit-read-only t))
        (teams4e--insert-message
         '((id . "fixture") (body . ((content . "<p>Plain <b>and bold</b></p>")))))))
    (should (string-match-p "Plain.*and bold" (buffer-string)))))

(ert-deftest teams4e-cancel-notifies-backend-and-discards-callback ()
  (let* ((teams4e--server-pending (make-hash-table :test #'eql))
         (request (teams4e--make-request 12))
         (server (make-pipe-process :name "teams4e-cancel-test" :buffer nil :noquery t))
         sent)
    (unwind-protect
        (progn
          (puthash 12 (list :request request :server server) teams4e--server-pending)
          (cl-letf (((symbol-function 'process-send-string)
                     (lambda (_process text) (push text sent))))
            (teams4e--cancel-process request))
          (should (teams4e-request-cancelled request))
          (should-not (gethash 12 teams4e--server-pending))
          (should (equal 12 (teams4e--get (json-parse-string (car sent)
                                                       :object-type 'alist) 'cancel))))
      (delete-process server))))

(ert-deftest teams4e-rapid-switching-ignores-reordered-completions ()
  (let ((teams4e-cache-first nil)
        (teams4e-display-images nil)
        (teams4e--recent-chat-cache nil)
        callbacks)
    (with-temp-buffer
      (teams4e-chat-mode)
      (cl-letf (((symbol-function 'teams4e--run-json)
                 (lambda (_args callback &optional _error)
                   (push (list callback teams4e--request-progress-callback) callbacks))))
        (dotimes (i 20)
          (setq teams4e--chat `((id . ,(format "chat-%d" i))))
          (teams4e-chat-refresh)))
      (funcall (caar callbacks) '(((id . "current") (body . ((content . "Latest"))))))
      (let ((tick (buffer-modified-tick)))
        (dolist (callbacks (cdr callbacks))
          (dolist (callback callbacks)
            (funcall callback '(((id . "stale") (body . ((content . "Old"))))))))
        (should (= tick (buffer-modified-tick)))
        (should (equal "current" (teams4e--get (car teams4e--messages) 'id)))))))

(ert-deftest teams4e-mode-switch-does-not-reuse-request-generation ()
  (let ((teams4e-cache-first nil) callbacks)
    (with-temp-buffer
      (cl-letf (((symbol-function 'teams4e--run-json)
                 (lambda (_args callback &optional _error) (push callback callbacks))))
        (teams4e-chat-mode)
        (setq teams4e--chat '((id . "same-chat")))
        (teams4e-chat-refresh)
        (teams4e-channel-thread-mode)
        (teams4e-chat-mode)
        (setq teams4e--chat '((id . "same-chat")))
        (teams4e-chat-refresh)
        (funcall (cadr callbacks) '(((id . "obsolete"))))
        (should-not teams4e--messages)))))

(ert-deftest teams4e-cache-to-live-follows-only-an-untouched-reader ()
  (dolist (moved '(nil t))
    (let ((teams4e-cache-first t)
          (teams4e-display-images nil)
          (teams4e-message-order 'oldest-first)
          (teams4e--recent-chat-cache nil)
          cached live)
      (with-temp-buffer
        (teams4e-chat-mode)
        (setq teams4e--chat '((id . "fixture"))
              teams4e--jump-to-bottom-on-render t)
        (cl-letf (((symbol-function 'teams4e--run-json)
                   (lambda (args callback &optional _error)
                     (if (member "cache" args) (setq cached callback)
                       (setq live callback)))))
          (let ((teams4e--cache-first-open t)) (teams4e-chat-refresh)))
        (funcall cached '(((id . "old") (body . ((content . "Cached exchange"))))))
        (should teams4e--cached-reader-view)
        (when moved (goto-char (point-min)))
        ;; Redisplay may not have caught up yet: following the cached end must
        ;; not rely on window-end alone to select the newest live message.
        (cl-letf (((symbol-function 'teams4e--reader-at-latest-p) (lambda () nil)))
          (funcall live '(((id . "new") (body . ((content . "Newest exchange")))))))
        (should (= (point) (if moved (point-min) (point-max))))
        (should-not teams4e--cached-reader-view)))))

(ert-deftest teams4e-first-page-is-reusable-before-older-history-finishes ()
  (let ((teams4e-cache-first t)
        (teams4e--recent-chat-cache nil)
        progress)
    (with-temp-buffer
      (teams4e-chat-mode)
      (setq teams4e--chat '((id . "fixture")))
      (cl-letf (((symbol-function 'teams4e--run-json)
                 (lambda (_args _callback &optional _error)
                   (setq progress teams4e--request-progress-callback))))
        (teams4e-chat-refresh))
      (funcall progress '(((id . "new"))))
      (should (equal '(((id . "new")))
                     (cdr (assoc (teams4e--recent-chat-key teams4e--chat)
                                 teams4e--recent-chat-cache)))))))

(ert-deftest teams4e-date-window-filters-created-time-not-edits ()
  (let* ((teams4e-message-days 3)
         (now (current-time))
         (messages `(((id . "old")
                      (createdDateTime . "2000-01-01T00:00:00Z")
                      (lastModifiedDateTime . ,(format-time-string "%FT%TZ" now t)))
                     ((id . "new")
                      (createdDateTime . ,(format-time-string "%FT%TZ" now t))))))
    (should-not (member "--modifiedStartDateTime"
                        (teams4e--message-args '((id . "fixture")))))
    (should (equal '("new")
                   (mapcar (lambda (m) (teams4e--get m 'id))
                           (teams4e--chat-window-messages messages))))
    (should (= 2 (length (teams4e--chat-window-messages messages t))))
    (should (= 2 (length (teams4e--chat-window-messages messages nil t))))))

(ert-deftest teams4e-snooze-expiry-redraws-and-persists-without-reader-follow ()
  (let* ((directory (make-temp-file "teams4e-wake-" t))
         (teams4e-state-file (expand-file-name "state.json" directory))
         (teams4e--state-loaded t)
         (teams4e--snoozed (make-hash-table :test #'equal))
         (teams4e--snooze-timer nil)
         (teams4e--favorites (make-hash-table :test #'equal))
         (teams4e--muted (make-hash-table :test #'equal))
         (teams4e--handled (make-hash-table :test #'equal))
         (teams4e--saved-views (make-hash-table :test #'equal))
         (now (date-to-time "2026-11-03T07:00:00Z"))
         (redraws 0))
    (unwind-protect
        (cl-letf (((symbol-function 'current-time) (lambda () now))
                  ((symbol-function 'teams4e--refresh-visible-recent)
                   (lambda ()
                     (should teams4e--inhibit-reader-follow)
                     (cl-incf redraws))))
          (puthash "wake" "2026-11-03T06:59:00Z" teams4e--snoozed)
          (puthash "later" "2099-11-04T07:00:00Z" teams4e--snoozed)
          (teams4e--wake-snoozes teams4e--snoozed teams4e-state-file)
          (should (= 1 redraws))
          (should-not (gethash "wake" teams4e--snoozed))
          (should (gethash "later" teams4e--snoozed))
          (should (timerp teams4e--snooze-timer))
          (setq teams4e--state-loaded nil)
          (teams4e--load-state)
          (should-not (gethash "wake" teams4e--snoozed))
          (should (gethash "later" teams4e--snoozed))
          ;; A timer from a different state/account must not modify this one.
          (teams4e--wake-snoozes (make-hash-table) teams4e-state-file)
          (should (= 1 redraws)))
      (when (timerp teams4e--snooze-timer) (cancel-timer teams4e--snooze-timer))
      (delete-directory directory t))))

(ert-deftest teams4e-snooze-load-arms-overdue-wake-without-network ()
  (let ((teams4e--snoozed (make-hash-table :test #'equal))
        (teams4e--snooze-timer nil)
        scheduled)
    (puthash "overdue" "2000-01-01T00:00:00Z" teams4e--snoozed)
    (cl-letf (((symbol-function 'run-at-time)
               (lambda (&rest args) (setq scheduled args)))
              ((symbol-function 'teams4e--run-json)
               (lambda (&rest _) (ert-fail "Snooze timers must not contact Graph"))))
      (teams4e--schedule-snooze-wake)
      (should (<= (car scheduled) 0.01))
      (should (eq #'teams4e--wake-snoozes (nth 2 scheduled))))))

(ert-deftest teams4e-snoozed-conversation-survives-bounded-recents-refresh ()
  (let* ((teams4e--state-loaded t)
         (teams4e--snoozed (make-hash-table :test #'equal))
         (teams4e--chats '(((id . "sleeping")) ((id . "old-recents")))))
    (puthash "sleeping" "2099-01-01T07:00:00Z" teams4e--snoozed)
    (cl-letf (((symbol-function 'teams4e--run-json)
               (lambda (_args callback &optional _error)
                 (funcall callback '(((id . "new-recents")))))))
      (teams4e--load-chats #'ignore))
    (should (equal '("new-recents" "sleeping")
                   (sort (mapcar #'teams4e--chat-id teams4e--chats) #'string<)))))

(ert-deftest teams4e-overdue-snooze-timer-really-fires ()
  (let ((teams4e--state-loaded t)
        (teams4e--snoozed (make-hash-table :test #'equal))
        (teams4e--snooze-timer nil)
        redrawn)
    (unwind-protect
        (cl-letf (((symbol-function 'teams4e--save-state) #'ignore)
                  ((symbol-function 'teams4e--refresh-visible-recent)
                   (lambda () (setq redrawn t))))
          (puthash "overdue" "2000-01-01T00:00:00Z" teams4e--snoozed)
          (teams4e--schedule-snooze-wake)
          (let ((deadline (+ (float-time) 2)))
            (while (and (not redrawn) (< (float-time) deadline)) (sleep-for 0.02)))
          (should redrawn)
          (should-not (gethash "overdue" teams4e--snoozed)))
      (when (timerp teams4e--snooze-timer) (cancel-timer teams4e--snooze-timer)))))

(ert-deftest teams4e-expired-snooze-returns-only-to-matching-views ()
  (let* ((teams4e--state-loaded t)
         (teams4e--snoozed (make-hash-table :test #'equal))
         (teams4e--snooze-timer nil)
         (teams4e--read-overrides (make-hash-table :test #'equal))
         (teams4e--muted (make-hash-table :test #'equal))
         (teams4e--handled (make-hash-table :test #'equal))
         (chat '((id . "wake") (chatType . "group")
                 (lastMessagePreview . ((id . "message")
                                        (createdDateTime . "2026-11-03T06:00:00Z")))))
         (now (date-to-time "2026-11-03T06:59:00Z")))
    (cl-letf (((symbol-function 'current-time) (lambda () now))
              ((symbol-function 'teams4e--save-state) #'ignore)
              ((symbol-function 'teams4e--refresh-visible-recent) #'ignore))
      (puthash "wake" "2026-11-03T07:00:00Z" teams4e--snoozed)
      (should-not (teams4e--built-in-view-chat-p chat 'unread))
      (setq now (date-to-time "2026-11-03T07:00:01Z"))
      (teams4e--wake-snoozes teams4e--snoozed teams4e-state-file)
      (should (teams4e--built-in-view-chat-p chat 'unread))
      (should-not (teams4e--built-in-view-chat-p chat 'snoozed))
      (puthash "wake" (cons 'read (teams4e--last-message-marker chat))
               teams4e--read-overrides)
      (should-not (teams4e--built-in-view-chat-p chat 'unread))
      (should (teams4e--built-in-view-chat-p chat 'all)))))

(provide 'teams4e-reliability-tests)
